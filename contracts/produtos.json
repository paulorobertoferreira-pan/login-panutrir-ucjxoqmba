{
  "contract_id": "panutrir.fase1.produtos",
  "version": "1.0.0",
  "status": "fixture_sintetica",
  "description": "Catálogo sintético mínimo de produtos com vigência temporal.",
  "primary_key": ["produto_codigo"],
  "file_rules": {
    "extension": ".csv",
    "encoding": "UTF-8",
    "delimiters": [",", ";"],
    "max_bytes": 1048576,
    "max_data_rows": 10000,
    "max_columns": 20,
    "header_required": true
  },
  "cross_field_rules": [
    "produto_codigo deve ser único no arquivo.",
    "vigencia_fim, quando preenchida, não pode ser anterior a vigencia_inicio.",
    "produto_nome é texto sintético e não pode começar por prefixo de fórmula."
  ],
  "columns": [
    {
      "name": "produto_codigo",
      "type": "string",
      "required": true,
      "max_length": 8,
      "pattern": "^PROD-[0-9]{3}$",
      "description": "Código sintético canônico do produto."
    },
    {
      "name": "produto_nome",
      "type": "string",
      "required": true,
      "max_length": 80,
      "description": "Nome sintético do produto; não contém PII real."
    },
    {
      "name": "linha_codigo",
      "type": "string",
      "required": true,
      "max_length": 6,
      "pattern": "^LIN-[0-9]{2}$",
      "description": "Código sintético da linha."
    },
    {
      "name": "unidade_medida",
      "type": "enum",
      "required": true,
      "allowed_values": ["UN", "KG", "CX"],
      "description": "Unidade sintética de comercialização."
    },
    {
      "name": "ativo",
      "type": "boolean",
      "required": true,
      "allowed_values": ["true", "false"],
      "description": "Indica se o produto está ativo no fixture."
    },
    {
      "name": "vigencia_inicio",
      "type": "date",
      "required": true,
      "format": "YYYY-MM-DD",
      "description": "Início da vigência sintética."
    },
    {
      "name": "vigencia_fim",
      "type": "date",
      "required": false,
      "nullable": true,
      "format": "YYYY-MM-DD",
      "description": "Fim da vigência; vazio significa vigente no recorte do fixture."
    }
  ],
  "invalid_cases": [
    "produto_codigo duplicado",
    "unidade_medida fora do conjunto permitido",
    "ativo diferente de true/false",
    "vigencia_fim anterior a vigencia_inicio",
    "produto_nome iniciado por prefixo de fórmula",
    "arquivo vazio, delimitador não suportado, encoding inválido ou nome inseguro"
  ]
}
